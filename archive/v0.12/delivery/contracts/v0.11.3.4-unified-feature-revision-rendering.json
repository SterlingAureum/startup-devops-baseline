  "status": "offline-implemented-live-replay-required",
  "repository": "SterlingAureum/startup-devops-baseline",
  "designDocument": "docs/V0.11.3.4_UNIFIED_FEATURE_REVISION_RENDERING.md",
  "sourceModel": {
    "rootApplication": "clusters/local/root-app.yaml",
