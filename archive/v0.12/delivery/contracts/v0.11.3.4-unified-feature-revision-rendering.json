    "sameRepositoryRevisionValue": "git.targetRevision",
    "stableRevision": "HEAD",
    "externalChartVersionsRemainIndependent": true
  },
  "featureInput": {
    "operatorInput": "TARGET_REVISION",
    "remoteBranchResolvedOnce": true,
    "resolvedForm": "full-40-character-commit-sha",
    "localCommitMustMatchRemote": true,
    "trackedWorkingTreeMustBeClean": true,
    "rootAndChildrenUseResolvedCommit": true
  },
  "rootRendering": {
