      "name": "monitoring-aws-test",
      "source": {
        "chart": "kube-prometheus-stack",
        "helm": {
          "releaseName": "observability-metrics",
          "valuesObject": {
            "alertmanager": {
              "alertmanagerSpec": {
                "automountServiceAccountToken": false,
                "nodeSelector": {
                  "workload": "system"
                },
                "replicas": 1,
                "resources": {
                  "limits": {
                    "cpu": "200m",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  }
                },
                "retention": "48h",
                "storage": {
                  "volumeClaimTemplate": {
                    "spec": {
                      "accessModes": [
                        "ReadWriteOnce"
                      ],
                      "resources": {
                        "requests": {
                          "storage": "2Gi"
                        }
                      },
                      "storageClassName": "gp3-observability-alertmanager"
                    }
                  }
                }
              },
              "config": {
                "global": {
                  "resolve_timeout": "5m"
                },
                "inhibit_rules": [
                  {
                    "equal": [
                      "environment",
                      "cluster",
                      "component",
                      "alert_family"
                    ],
                    "source_matchers": [
                      "severity = \"critical\""
                    ],
                    "target_matchers": [
                      "severity = \"warning\""
                    ]
                  }
                ],
                "receivers": [
                  {
                    "name": "platform-observation"
                  },
                  {
                    "name": "critical-observation"
                  },
                  {
                    "name": "warning-observation"
                  },
                  {
                    "name": "critical-drill-webhook",
                    "webhook_configs": [
                      {
                        "send_resolved": true,
                        "url": "http://alert-lifecycle-drill-sink.observability.svc.cluster.local:8080/critical"
                      }
                    ]
                  },
                  {
                    "name": "warning-drill-webhook",
                    "webhook_configs": [
                      {
                        "send_resolved": true,
                        "url": "http://alert-lifecycle-drill-sink.observability.svc.cluster.local:8080/warning"
                      }
                    ]
                  }
                ],
                "route": {
                  "group_by": [
                    "environment",
                    "cluster",
                    "component",
                    "alert_family"
                  ],
                  "group_interval": "5m",
                  "group_wait": "30s",
                  "receiver": "platform-observation",
                  "repeat_interval": "4h",
                  "routes": [
                    {
                      "continue": true,
                      "group_interval": "2s",
                      "group_wait": "1s",
                      "matchers": [
                        "drill = \"true\"",
                        "alert_family = \"alert-lifecycle-drill\"",
                        "severity = \"critical\""
                      ],
                      "receiver": "critical-drill-webhook",
                      "repeat_interval": "1h"
                    },
                    {
                      "continue": true,
                      "group_interval": "2s",
                      "group_wait": "1s",
                      "matchers": [
                        "drill = \"true\"",
                        "alert_family = \"alert-lifecycle-drill\"",
                        "severity = \"warning\""
                      ],
                      "receiver": "warning-drill-webhook",
                      "repeat_interval": "1h"
                    },
                    {
                      "matchers": [
                        "severity = \"critical\""
                      ],
                      "receiver": "critical-observation"
                    },
                    {
                      "matchers": [
                        "severity = \"warning\""
                      ],
                      "receiver": "warning-observation"
                    }
                  ]
                },
                "templates": [
                  "/etc/alertmanager/config/*.tmpl"
