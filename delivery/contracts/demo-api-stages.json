{
  "schemaVersion": "v0.10.6",
  "application": "demo-api",
  "defaultRef": "refs/heads/main",
  "executionBoundary": {
    "runner": "github-hosted",
    "clusterAccess": false,
    "awsCredentials": "none",
    "automaticMerge": false,
    "automaticEnvironmentCreation": false
  },
  "stages": [
    {
      "id": "image-publish",
      "workflow": ".github/workflows/demo-api-image-publish.yaml",
      "entrypoints": [
        "push-main",
        "workflow-dispatch",
        "workflow-call"
      ],
      "requiresProtectedMainForOrchestration": true,
      "inputs": {
        "caller_ref": "string",
        "create_promotion_pr": "boolean",
        "promotion_base_branch": "string"
      },
      "outputs": [
        "image_repository",
        "image_tag",
        "image_digest",
        "metadata_artifact_name",
        "promotion_status",
        "promotion_pr_url"
      ],
      "primitiveScripts": [
        "scripts/write-demo-api-image-metadata.sh",
        "scripts/promote-demo-api-image.sh",
        "scripts/set-demo-api-delivery-metadata.sh"
      ],
      "mutationScope": [
        "ghcr-image-and-attestations",
        "optional-aws-dev-release-only-pr"
      ],
      "environmentApproval": "not-applicable"
    },
    {
      "id": "static-qualification",
      "workflow": ".github/workflows/demo-api-record-release-evidence.yaml",
      "entrypoints": [
        "workflow-dispatch",
        "workflow-call"
      ],
      "requiresProtectedMainForOrchestration": true,
      "inputs": {
        "environment": "string",
        "mode": "string",
        "expected_control_plane_sha": "string"
      },
      "allowedEnvironments": [
        "aws-dev",
        "aws-test"
      ],
      "outputs": [
        "status",
        "pr_url",
        "evidence_file",
        "image_reference",
        "base_revision",
        "artifact_name",
        "source_commit",
        "image_digest",
        "release_file_sha256"
      ],
      "primitiveScripts": [
        "scripts/write-demo-api-release-evidence.sh",
        "scripts/validate-demo-api-release-evidence.sh"
      ],
      "mutationScope": [
        "same-run-static-artifact",
        "optional-static-evidence-only-pr"
      ],
      "environmentApproval": "target-environment"
    },
    {
      "id": "qualification-bundle",
      "workflow": ".github/workflows/demo-api-record-qualification-bundle.yaml",
      "entrypoints": [
        "workflow-call"
      ],
      "requiresProtectedMainForOrchestration": true,
      "inputs": {
        "environment": "string",
        "release_id": "string",
        "control_plane_sha": "string",
        "static_artifact_name": "string",
        "runtime_artifact_name": "string"
      },
      "allowedEnvironments": [
        "aws-dev",
        "aws-test"
      ],
      "outputs": [
        "status",
        "pr_url",
        "bundle_file"
      ],
      "primitiveScripts": [
        "scripts/calculate-demo-api-qualification-scope.py",
        "scripts/write-demo-api-qualification-bundle.py",
        "scripts/validate-demo-api-qualification-bundle.py"
      ],
      "mutationScope": [
        "qualification-bundle-only-pr"
      ],
      "environmentApproval": "not-applicable"
    },
    {
      "id": "environment-promotion",
      "workflow": ".github/workflows/demo-api-promote-environment.yaml",
      "entrypoints": [
        "workflow-dispatch",
        "workflow-call"
      ],
      "requiresProtectedMainForOrchestration": true,
      "inputs": {
        "source_environment": "string",
        "target_environment": "string",
        "qualification_mode": "string",
        "evidence_run_id": "string",
        "runtime_evidence_id": "string",
        "qualification_bundle_path": "string",
        "qualification_bundle_sha256": "string",
        "release_id": "string",
        "control_plane_sha": "string"
      },
      "allowedEdges": [
        "aws-dev->aws-test",
        "aws-test->aws-prod"
      ],
      "outputs": [
        "status",
        "pr_url",
        "target_release_path",
        "image_tag",
        "image_digest",
        "source_commit"
      ],
      "primitiveScripts": [
        "scripts/validate-demo-api-release-evidence.sh",
        "scripts/validate-demo-api-runtime-evidence.sh",
        "scripts/validate-demo-api-qualification-bundle.py",
        "scripts/promote-demo-api-release.sh"
      ],
      "mutationScope": [
        "target-release-only-pr"
      ],
      "environmentApproval": "target-environment"
    },
    {
      "id": "rollback-handoff",
      "workflow": ".github/workflows/demo-api-rollback.yaml",
      "entrypoints": [
        "workflow-dispatch",
        "workflow-call"
      ],
      "requiresProtectedMainForOrchestration": true,
      "inputs": {
        "target_environment": "string",
        "rollback_to_revision": "string"
      },
      "allowedEnvironments": [
        "aws-dev",
        "aws-test",
        "aws-prod"
      ],
      "outputs": [
        "status",
        "pr_url",
        "target_environment",
        "target_revision",
        "image_tag",
        "image_digest"
      ],
      "primitiveScripts": [
        "scripts/prepare-demo-api-rollback.sh"
      ],
      "mutationScope": [
        "target-release-only-pr"
      ],
      "environmentApproval": "target-environment"
    }
  ],
  "orchestration": {
    "contract": "delivery/contracts/demo-api-orchestrator.json",
    "executionMode": "bounded-reviewed-promotion",
    "stageDispatch": true
  },
  "deferredStages": {
    "runtimeQualification": "v0.10.5-dispatched-aws-dev-and-aws-test",
    "qualificationBundle": "v0.10.5-implemented-dev-and-test",
    "productionPromotion": "v0.10.6-reviewed-pr-preparation"
  }
}
