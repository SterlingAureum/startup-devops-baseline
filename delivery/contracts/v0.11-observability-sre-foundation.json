  "designDocument": "docs/V0.11_OBSERVABILITY_SRE_DESIGN.md",
  "roadmapDocument": "docs/ROADMAP.md",
  "previousVersionBoundary": {
    "version": "v0.10",
    "acceptanceEvidenceImmutable": true,
    "contractsRemainAuthoritativeForV010": true,
    "orchestratorBehaviorChangedByV0110": false,
    "workflowPermissionsChangedByV0110": false
  },
  "increments": [
    {
      "id": "v0.11.0",
      "name": "observability-sre-design-foundation",
      "status": "delivered"
    },
    {
      "id": "v0.11.1",
      "name": "production-metrics-foundation",
      "status": "planned"
    },
    {
      "id": "v0.11.2",
      "name": "application-and-platform-telemetry",
      "status": "planned"
    },
    {
      "id": "v0.11.3",
      "name": "dashboards-and-recording-rules",
      "status": "planned"
    },
    {
      "id": "v0.11.4",
      "name": "actionable-alerting-and-runbooks",
      "status": "planned"
    },
    {
      "id": "v0.11.5",
      "name": "centralized-logging-and-extensible-tracing",
      "status": "planned"
    },
    {
      "id": "v0.11.6",
      "name": "sli-slo-and-progressive-delivery-gates",
      "status": "planned"
    },
    {
      "id": "v0.11.7",
