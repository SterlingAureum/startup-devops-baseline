  "logSchema": {
    "requiredFields": [
      "timestamp",
      "severity",
      "message",
      "service.name",
      "service.version",
      "deployment.environment.name",
      "platform.release.id",
      "platform.source.commit",
      "container.image.digest"
    ],
    "conditionalCorrelationFields": [
      "trace_id",
      "span_id"
    ],
    "optionalBoundedFields": [
      "http.request.method",
      "http.route",
      "http.response.status_code",
      "duration_ms",
      "db.system",
      "outcome"
    ],
    "forbiddenFields": [
      "http.request.body",
      "http.request.header.authorization",
      "http.request.header.cookie",
      "db.query.parameter",
      "db.statement.raw",
      "enduser.id",
      "raw.url.query",
      "credential",
      "secret"
    ]
  },
  "lokiLabelPolicy": {
    "allowedBoundedLabels": [
      "environment",
      "cluster",
      "namespace",
      "application",
      "container",
      "severity"
    ],
    "structuredFieldsNotIndexedLabels": [
      "trace_id",
      "span_id",
      "platform.release.id",
      "platform.source.commit",
      "container.image.digest",
      "pod.uid",
      "pod.ip",
      "request.id",
      "enduser.id",
      "raw.url"
