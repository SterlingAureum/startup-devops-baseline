    "responseBodyCaptured": false,
    "authorizationHeaderCaptured": false,
    "cookieHeaderCaptured": false,
    "databaseUrlCaptured": false,
    "rawSqlCaptured": false,
    "databaseParametersCaptured": false,
    "exceptionMessageCaptured": false,
