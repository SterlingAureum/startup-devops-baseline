  "coverageMeaning": "Pure-rule fixtures cover ordering and captured continuation decisions; live adapter integration and real authorization/journal/transport remain pending.",
  "dependencyRules": [
    "Completed sequence must be an exact confirmed-receipt prefix; proposed step is the next one only.",
    "Apps frozen/removed and no active operation before dependent teardown.",
    "ExternalSecrets must drain before business namespace and scoped RBAC deletion; pending objects require ready ESO, patch access and retained permissions.",
    "Unknown finalizers stop; no generic force-finalizer or privilege repair path.",
    "Keep cleanup controllers until runtime compute/storage/LB dependencies drain.",
    "No EKS deletion before runtime absence and node config removal; no final deletion before EKS/ENI/SG absence."
  ],
  "eniRules": [
    "Bind private captured account/VPC/subnet/SG/cluster and exact captured-node description tokens.",
    "Exact captured interface identity signature must match fresh native row and complete group query.",
    "Only available interface, non-requester-managed, type interface; Attachment and Association absent/null.",
    "Current interface requires its group present; absent interface requires empty complete group-interface inventory.",
    "No delete-once decision after an attempted operation; confirmed absent does not repeat mutation."
  ],
  "sgRules": [
    "Exact captured group snapshot, account/VPC/cluster ownership and complete VPC group inventory.",
    "No interfaces and no incoming references from other groups in ingress or egress.",
    "Duplicate/moved/disagreeing/malformed inventory stops.",
    "Absence skips delete; an attempted still-present group cannot receive repeat-delete decision."
  ],
  "intentionalTightenings": [
    "Description node association uses exact instance-ID tokens rather than substring matches.",
    "Attachment/Association empty objects are not treated as proven absence; only absent/null is accepted.",
    "Explicit dev/test/prod cluster suffix must match supplied environment profile."
  ],
  "adapterResponsibilities": [
    "Hash-bind private snapshots, fresh account/main/state/release, complete native observations, approved phase and clocks.",
    "Bind completed receipt prefix to confirmed observed outcomes, not proposed or attempted steps.",
    "Hash-bind captured ENI/SG snapshots, check fresh group ownership and native complete inventory before mutation.",
    "Reserve durable exclusive per-operation attempt and write-ahead journal before any mutation; attempted is not reset after failure.",
    "Recheck native conditions immediately before calls; API race rejection stops without detach, rule changes or retry.",
    "Only create phase completion receipt after all independent postconditions pass; confirmed-absent is a rule result, not a receipt writer."
  ],
