  "releaseNoteReview": {
    "announcedManualMigrationRequired": false,
    "repositoryRelevantChanges": [
      {
        "change": "external-secret-optional-strategy-default-removal",
        "effect": "The v1 API no longer persists defaults for conversionStrategy, decodingStrategy, metadataPolicy and valuesDecodingStrategy.",
        "repositoryDisposition": "compatible-explicit-values",
        "reason": "The active manifest explicitly sets conversionStrategy=Default, decodingStrategy=None and metadataPolicy=None and does not use templateFrom."
      },
      {
        "change": "secret-template-from-target-restriction",
        "effect": "Secret targets accept only Data, Annotations or Labels for templateFrom, with controller-side enforcement as defense in depth.",
        "repositoryDisposition": "not-exercised",
        "reason": "The repository ExternalSecret has no templateFrom entries."
      },
      {
        "change": "controller-runtime-upgrade",
        "effect": "Controller-runtime changes can affect watches, cache behavior and reconciliation timing even though the rendered topology is stable.",
        "repositoryDisposition": "requires-live-convergence-proof",
        "reason": "Static render evidence cannot prove runtime reconciliation."
      },
      {
        "change": "optional-scheduler-and-runtime-class-values",
        "effect": "The chart adds opt-in schedulerName and runtimeClassName values.",
        "repositoryDisposition": "not-enabled",
        "reason": "Neither value is configured and the rendered Pod specs change only labels and image tags."
      },
      {
        "change": "aws-replication-delete-fixes",
        "effect": "AWS Secrets Manager replica-region handling changes deletion behavior.",
        "repositoryDisposition": "outside-active-read-path",
        "reason": "PushSecret is disabled and this hop does not delete or replicate remote secrets."
      }
    ],
