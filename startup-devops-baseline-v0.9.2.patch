diff --git a/infra/terraform/aws/environments/test/providers.tf b/infra/terraform/aws/environments/test/providers.tf
new file mode 100644
index 0000000000000000000000000000000000000000..f8024a5e55a93ec7bc54d357b3777c2d0992cf19
