+if [[ "${CONFIRM_AWS_TEST_BOOTSTRAP:-}" != "bootstrap-ephemeral-aws-test" ]]; then
+  cat >&2 <<'EOF'
+This bootstraps Argo CD and applies the aws-test root Application to the
